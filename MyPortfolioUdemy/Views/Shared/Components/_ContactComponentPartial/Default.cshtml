<section id="contact" class="s-contact target-section">

    <div class="overlay"></div>

    <div class="row narrow section-intro">
        <div class="col-full">
            <h3>İletişim</h3>
            <h1>Bana Ulaşın.</h1>

            <p class="lead">Yazılım alanında kendimi geliştirmeye devam ediyorum. Projeler, öneriler ya da sorularınız için benimle iletişime geçebilirsiniz.</p>
        </div>
    </div>

    <div class="row contact__main">
        <div class="col-eight tab-full contact__form">
            <form name="contactForm" id="contactForm" method="post" action="">
                <fieldset>

                    <div class="form-field">
                        <input name="contactName" type="text" id="contactName" placeholder="İsim-Soyisim" value="" minlength="2" required="" aria-required="true" class="full-width">
                    </div>
                    <div class="form-field">
                        <input name="contactEmail" type="email" id="contactEmail" placeholder="Mail" value="" required="" aria-required="true" class="full-width">
                    </div>
                    <div class="form-field">
                        <input name="contactSubject" type="text" id="contactSubject" placeholder="Konu" value="" class="full-width">
                    </div>
                    <div class="form-field">
                        <textarea name="contactMessage" id="contactMessage" placeholder="Mesaj" rows="10" cols="50" required="" aria-required="true" class="full-width"></textarea>
                    </div>
                    <div class="form-field">
                        <button class="full-width btn--primary">Gönder</button>
                        <div class="submit-loader">
                            <div class="text-loader">Gönderiliyor...</div>
                            <div class="s-loader">
                                <div class="bounce1"></div>
                                <div class="bounce2"></div>
                                <div class="bounce3"></div>
                            </div>
                        </div>
                    </div>

                </fieldset>
            </form>

            <!-- contact-warning -->
            <div class="message-warning">
                Bir sorun oluştu.Lütfen tekrar deneyiniz!
            </div>

            <!-- contact-success -->
            <div class="message-success">
                Mesaj gönderildi,teşekkürler:)<br>
            </div>

        </div>
        <div class="col-four tab-full contact__infos">
            <h4 class="h06">Telefon</h4>
            <p>
                Telefon numarası: (+63) 555 1212<br>
                Cep numarası: (+63) 555 0100<br>
                Fax: (+63) 555 0101
            </p>

            <h4 class="h06">Mail</h4>
            <p>
                nisaayata@gmail.com<br>
                info@niss.com
            </p>

            <h4 class="h06">Adres</h4>
            <p>
                Bayrampaşa<br>
                İstanbul,Türkiye<br>
                34 
            </p>
        </div>

    </div>

</section>